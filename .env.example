# TRAVELSPHERE OPS - Environment Configuration Template
# Copy this file to .env and configure environment variables for your deployment

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Security & JWT Token Authentication
# Generate a secure 256-bit secret key for production deployments
JWT_SECRET_KEY=travelsphere-ops-jwt-secret-key-2026-secure-franchise-ops
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Database Configuration
DATABASE_PATH=database/travelspere.db

# Frontend Application Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
